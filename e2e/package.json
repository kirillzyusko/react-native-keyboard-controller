{
  "name": "e2e-tests",
  "version": "1.0.0",
  "description": "Set of E2E tests for react-native-keyboard-controller package",
  "main": "index.js",
  "scripts": {
    "build-example:android": "cd ../example/android && ./gradlew assembleRelease --build-cache",
    "build-example:ios": "xcodebuild CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ -workspace ../example/ios/KeyboardControllerExample.xcworkspace -scheme KeyboardControllerExample -configuration Release -sdk iphonesimulator -derivedDataPath ../example/ios/build",
    "test-example:android-28": "e2e run --target android-28 --retries 2",
    "test-example:android-31": "e2e run --target android-31 --retries 2",
    "test-example:ios-16": "e2e run --target ios-16 --retries 2",
    "test-example:ios-17": "e2e run --target ios-17 --retries 2",
    "test-example:ios-18": "e2e run --target ios-18 --retries 2",
    "test-example:ios-26": "e2e run --target ios-26 --retries 2",
    "test-example:ios-26e": "e2e run --target ios-26e --retries 2",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirillzyusko/react-native-keyboard-controller.git"
  },
  "keywords": [
    "e2e"
  ],
  "author": "Kiryl Ziusko <zyusko.kirik@gmail.com> (https://github.com/kirillzyusko)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kirillzyusko/react-native-keyboard-controller/issues"
  },
  "homepage": "https://github.com/kirillzyusko/react-native-keyboard-controller#readme",
  "devDependencies": {
    "@e2e-dev/mobile": "^0.12.7",
    "@types/node": "^24",
    "e2e": "^0.23.1"
  }
}
