diff --git a/node_modules/react-native-screens/ios/RNSScreen.mm b/node_modules/react-native-screens/ios/RNSScreen.mm
--- a/node_modules/react-native-screens/ios/RNSScreen.mm
+++ b/node_modules/react-native-screens/ios/RNSScreen.mm
@@ -1424,6 +1424,7 @@
 
 @implementation RNSScreen {
   __weak id _previousFirstResponder;
+  __weak UIView *_swipeFirstResponder;
   CGRect _lastViewFrame;
   RNSScreenView *_initialView;
   UIView *_fakeView;
@@ -1672,6 +1673,31 @@
 {
   CGFloat totalHeight = [self calculateHeaderHeightIsModal:isModal];
   [self.screenView notifyHeaderHeightChange:totalHeight];
+}
+
+- (void)prepareKeyboardForSwipe
+{
+  if (self.screenView.hideKeyboardOnSwipe && self.navigationController.topViewController == self &&
+      self.navigationController.viewControllers.count > 1) {
+    _swipeFirstResponder = [self findFirstResponder:self.screenView];
+    [_swipeFirstResponder resignFirstResponder];
+  }
+}
+
+- (void)restoreKeyboardAfterSwipe
+{
+  UIView *responder = _swipeFirstResponder;
+  _swipeFirstResponder = nil;
+  if (responder == nil) {
+    return;
+  }
+  // On cancellation, restore outside UIKit's transition transaction.
+  dispatch_async(dispatch_get_main_queue(), ^{
+    if (responder.window != nil && self.navigationController.topViewController == self &&
+        [self findFirstResponder:self.screenView] == nil) {
+      [responder becomeFirstResponder];
+    }
+  });
 }
 
 - (void)notifyFinishTransitioning
