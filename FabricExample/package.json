{
  "name": "keyboardcontrollerfabricexample",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "web": "webpack serve --mode=development --config webpack.config.js",
    "build:web": "webpack --mode=production --config webpack.config.js",
    "start": "react-native start",
    "test": "jest",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@legendapp/list": "3.3.10",
    "@lottiefiles/dotlottie-react": "0.19.16",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "7.18.18",
    "@react-navigation/elements": "2.9.40",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "@react-navigation/stack": "7.10.24",
    "@shopify/flash-list": "2.3.2",
    "@shopify/react-native-skia": "2.11.2",
    "lottie-react-native": "7.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.87.1",
    "react-native-advanced-input-mask": "^1.4.6",
    "react-native-gesture-handler": "3.2.1",
    "react-native-haptic-feedback": "3.0.0",
    "react-native-keyboard-controller": "link:../",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.27.0",
    "react-native-toast-message": "2.5.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.12.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-loader": "10.1.1",
    "babel-plugin-react-native-web": "^0.21.2",
    "html-webpack-plugin": "5.6.8",
    "jest": "30.5.1",
    "patch-package": "8.0.1",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3",
    "url-loader": "^4.1.1",
    "webpack": "5.110.3",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "resolver": "react-native-reanimated/jest/resolver",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "setupFiles": [
      "./jestSetup.js"
    ],
    "moduleNameMapper": {
      "^react-native-reanimated$": "<rootDir>/node_modules/react-native-reanimated/lib/module/index.js",
      "^react-native-reanimated/mock$": "<rootDir>/node_modules/react-native-reanimated/lib/module/mock.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?@?react-native|@react-native-community|@react-navigation)"
    ],
    "moduleDirectories": [
      "<rootDir>/node_modules",
      "node_modules"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "USE_COMMIT_HOOK_ONLY_FOR_REACT_COMMITS": true
    }
  }
}
